<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PhoneBookViewer</RootNamespace>
    <AssemblyName>PhoneBookViewer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Образец телефонной книги копируется рядом с приложением. -->
    <None Update="data\phonebook.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
